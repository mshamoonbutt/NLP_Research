# Copy to .env (gitignored) and fill in. Never commit real values.
# The code reads these from the process environment; load them with e.g.
#   set -a; source .env; set +a
OPENAI_API_KEY=            # judge (configs/judge.yaml) -- Exp 1 calibration, Exp 2+ scoring
ANTHROPIC_API_KEY=         # chosen-refusal generator (Exp 6) -- must differ from the judge
HF_TOKEN=                  # gated Llama-3.2 weights/tokenizer on the GPU host
OLLAMA_HOST=http://localhost:11434   # only for the CPU smoke backend (--backend ollama)
